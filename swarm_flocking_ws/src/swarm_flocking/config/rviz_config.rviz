Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Grid1
        - /Centroid1
        - /ConvexHull1
        - /NeighborLinks1
      Splitter Ratio: 0.5
    Tree Height: 700
  - Class: rviz_common/Views
    Name: Views

Visualization Manager:
  Class: ""
  Name: root
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Alpha: 0.5
      Cell Size: 1
      Color: 160; 160; 164
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: map
      Value: true
    - Class: rviz_default_plugins/PointStamped
      Name: Centroid
      Enabled: true
      History Length: 50
      Color: 255; 128; 0
      Alpha: 1
      Radius: 0.15
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /flock/centroid
      Value: true
    - Class: rviz_default_plugins/Marker
      Name: ConvexHull
      Enabled: true
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /flock/convex_hull
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: NeighborLinks
      Enabled: true
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /flock/neighbor_links
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Robot0Odom
      Enabled: true
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_0/odom
      Shape:
        Alpha: 0.7
        Axes Length: 0.4
        Axes Radius: 0.04
        Color: 255; 25; 0
      Value: true
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Target Frame: map
      Scale: 35
      X: 15
      Y: 7.5
      Value: TopDownOrtho (rviz_default_plugins)
    Saved: ~

Window Geometry:
  Width: 1600
  Height: 900
  Displays:
    collapsed: false
  Views:
    collapsed: false
